# HungerSwipes Environment Variables
# Copy this to .env.local and fill in your values

# Supabase (https://supabase.com)
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Connect (for photographer payouts)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Internal admin secret (temporary V1 admin auth)
ADMIN_SECRET=change-me-in-production

# Comma-separated, verified Supabase account emails allowed to use owner controls.
# Keep this server-side; never prefix it with NEXT_PUBLIC_.
HUNGER_SWIPES_OWNER_EMAILS=owner@example.com
