{
  "name": "hunger-swipes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ios": "node scripts/build-ios-export.mjs",
    "build:ios:live": "IOS_BUILD=true next build && npx cap copy ios",
    "ios:open": "npx cap open ios",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/foundation.test.ts tests/discover-recovery.test.ts tests/discover-protection.test.ts tests/dish-admin.test.ts tests/dish-form.test.ts tests/launch-recovery.test.ts",
    "test:phase2b": "node --test --experimental-strip-types tests/phase2b.test.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:e2e": "playwright test",
    "test:gate3": "npm test && npm run test:ui && npm run lint && npm run build && npm run test:e2e",
    "test:security": "node --env-file=.env.local scripts/seller-security-audit.mjs",
    "test:stripe": "node scripts/test-food-intent-stripe-commerce.mjs",
    "places:import": "node --env-file=.env.local scripts/import-places.mjs",
    "places:google-enrich": "node --env-file=.env.local scripts/enrich-google-places.mjs"
  },
  "dependencies": {
    "@capacitor/action-sheet": "^8.1.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.0.1",
    "@supabase/supabase-js": "^2.101.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.7.0",
    "next": "16.3.5",
    "pdfkit": "^0.18.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
